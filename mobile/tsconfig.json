{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@shared/*": [
        "../src/*"
      ]
    },
    "types": [
      "jest"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "../src/lib/**/*.ts",
    "../src/store/billStoreCore.ts",
    "../src/store/uiStore.ts",
    "../src/hooks/useStepGate.ts"
  ],
  "exclude": [
    "node_modules",
    "../src/**/*.test.ts"
  ]
}
